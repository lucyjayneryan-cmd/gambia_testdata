# separate into appropriate sections (may not always be all groups)
check_data <- test %>% filter(port == "C")
gps_data <- test %>% filter(port == "G")
test <- test %>% filter(port == "p1")

# change unix time to asPOSIXct
# set format and then convert via mutate
test$ts<-as.numeric(test$` timestamp`)
test$signal<-as.numeric(test$signal)
test <- test %>% mutate(time = as_datetime(ts, tz = "UTC", origin = "1970-01-01"))
summary(test$time)

# plot signal or snr by time
test %>% ggplot(aes(x = time, y = signal)) +
  theme_bw() + 
  geom_point() + 
  labs(x = "Time of day", y = "Signal")


